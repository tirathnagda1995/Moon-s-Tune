# Optional cloud accounts. Leave both blank for local guest mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: account deletion, public moderation writes and private media storage.
SUPABASE_SERVICE_ROLE_KEY=
# Optional AI (requires Supabase auth and migrations for durable rate limiting).
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Canonical deployment origin, without trailing slash. Recommended for production.
APP_URL=

# Optional HTTPS moderation webhook. Without both, submissions stay pending.
MODERATION_URL=
MODERATION_API_KEY=
# Server-only bearer secret for scheduled expiry and media cleanup.
CRON_SECRET=
